{
  "name": "@uranus/executors",
  "version": "0.1.0",
  "description": "Uranus - shell cross-platform, sandbox por git worktree e verificador de contratos de aceite.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
