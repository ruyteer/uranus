  "files": [
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean"
  },
  "dependencies": {
    "@uranus/core": "workspace:*",
    "@uranus/telemetry": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@uranus/events": "workspace:*",
    "@uranus/testkit": "workspace:*"
  }
}
