{
  "name": "@uranus/cli",
  "version": "0.1.0",
  "description": "Uranus - CLI: init, task, start, status, logs, doctor.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "uranus": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "uranus-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean"
  },
  "dependencies": {
    "@uranus/agents": "workspace:*",
    "@uranus/backlog": "workspace:*",
    "@uranus/config": "workspace:*",
    "@uranus/context": "workspace:*",
    "@uranus/core": "workspace:*",
    "@uranus/memory": "workspace:*",
    "@uranus/events": "workspace:*",
    "@uranus/executors": "workspace:*",
    "@uranus/kernel": "workspace:*",
    "@uranus/prompts": "workspace:*",
    "@uranus/providers": "workspace:*",
    "@uranus/queue": "workspace:*",
    "@uranus/scheduler": "workspace:*",
    "@uranus/state": "workspace:*",
    "@uranus/vcs": "workspace:*",
    "commander": "^13.0.0",
    "yaml": "^2.6.0"
  }
}
